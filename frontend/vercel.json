{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/app.webmanifest",
      "has": [{ "type": "host", "value": "(dev\\.sportmaps\\.co|.*\\.vercel\\.app)" }],
      "destination": "https://sportmaps-bff-dev.onrender.com/api/v1/pwa/manifest"
    },
    {
      "source": "/app-icon.png",
      "has": [{ "type": "host", "value": "(dev\\.sportmaps\\.co|.*\\.vercel\\.app)" }],
      "destination": "https://sportmaps-bff-dev.onrender.com/api/v1/pwa/icon"
    },
    {
      "source": "/app.webmanifest",
      "destination": "https://sportmaps-bff-prod.onrender.com/api/v1/pwa/manifest"
    },
    {
      "source": "/app-icon.png",
      "destination": "https://sportmaps-bff-prod.onrender.com/api/v1/pwa/icon"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!torneo/[^/]+/embed).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/torneo/:slug/embed",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
