<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: los enlaces https://app.sportmaps.co abren la app en vez
                 del navegador. Con autoVerify=true Android descarga
                 https://app.sportmaps.co/.well-known/assetlinks.json al instalar y
                 compara la huella SHA-256 del certificado con el que firmo el APK.

                 La huella publicada es la del certificado de Play App Signing (el
                 deployment_cert que entrega Play Console), porque Play re-firma el
                 APK que reciben los usuarios: la llave de subida NO es la que llega
                 al dispositivo. Consecuencia practica: un APK instalado a mano con
                 la llave de subida NO verifica, y los enlaces siguen abriendo en el
                 navegador. Eso es esperado y no significa que este mal configurado.

                 Si se cambia el dominio, hay que cambiarlo en los dos lados a la
                 vez: aca y en frontend/public/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="app.sportmaps.co" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
