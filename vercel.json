{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true,
      "staging": true,
      "develop": true,
      "production": true
    }
  },
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    {
      "source": "/app.webmanifest",
      "has": [{ "type": "host", "value": "(dev\\.sportmaps\\.co|.*\\.vercel\\.app)" }],
      "destination": "https://bffdev.sportmaps.co/api/v1/pwa/manifest"
    },
    {
      "source": "/app-icon.png",
      "has": [{ "type": "host", "value": "(dev\\.sportmaps\\.co|.*\\.vercel\\.app)" }],
      "destination": "https://bffdev.sportmaps.co/api/v1/pwa/icon"
    },
    {
      "source": "/app.webmanifest",
      "has": [{ "type": "host", "value": "stg\\.sportmaps\\.co" }],
      "destination": "https://sportmaps-bff-stg.onrender.com/api/v1/pwa/manifest"
    },
    {
      "source": "/app-icon.png",
      "has": [{ "type": "host", "value": "stg\\.sportmaps\\.co" }],
      "destination": "https://sportmaps-bff-stg.onrender.com/api/v1/pwa/icon"
    },
    {
      "source": "/app.webmanifest",
      "destination": "https://sportmaps-bff-prod.onrender.com/api/v1/pwa/manifest"
    },
    {
      "source": "/app-icon.png",
      "destination": "https://sportmaps-bff-prod.onrender.com/api/v1/pwa/icon"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
